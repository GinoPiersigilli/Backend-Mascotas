            "example" : "Av Colon 1000",
            "type" : "string"
          },
          "fechaActualizacion" : {
            "example" : "2026-10-27T13:00:00",
            "format" : "date-time",
            "type" : "string"
          },
          "hayNinios" : {
            "example" : false,
            "type" : "boolean"
          },
          "hayOtrosAnimales" : {
            "example" : false,
            "type" : "boolean"
          },
          "localidad" : {
            "example" : "Cordoba",
            "type" : "string"
          },
          "nombreCompleto" : {
            "example" : "Ana Perez",
            "type" : "string"
          },
          "provincia" : {
            "example" : "Cordoba",
            "type" : "string"
          },
          "telefono" : {
            "example" : "3515550000",
            "type" : "string"
          },
          "tienePatio" : {
            "example" : true,
            "type" : "boolean"
          },
          "tipoVivienda" : {
            "enum" : [ "CASA", "DEPARTAMENTO" ],
            "example" : "CASA",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ReconciliacionResponse" : {
        "properties" : {
          "conflictos" : {
            "description" : "Desincronizaciones no auto-reparables que requieren revision manual",
            "example" : 0,
            "format" : "int32",
            "type" : "integer"
          },
          "detalles" : {
            "description" : "Detalle de inconsistencias detectadas",
