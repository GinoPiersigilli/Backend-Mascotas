        "description" : "201 PENDIENTE con marcas, o 201 RECHAZADA si hay incompatibilidad dura (R-04)",
        "operationId" : "crear",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Crear"
              }
            }
