            "format" : "double",
            "type" : [ "number", "null" ]
          },
          "total" : {
            "description" : "Cantidad total de solicitudes registradas",
            "example" : 12,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
