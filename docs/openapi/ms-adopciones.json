  "info" : {
    "description" : "Proceso de adopcion: perfiles, solicitudes, evaluacion con Georef, entrega y seguimiento",
    "title" : "ms-adopciones",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/adoptantes/me/perfil" : {
      "get" : {
        "operationId" : "obtenerPropio",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PerfilResponse"
                }
              }
            },
            "description" : "Perfil encontrado"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "No autenticado"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Rol insuficiente (requiere ADOPTANTE)"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Todavia no lo completo"
          }
        },
        "summary" : "Consulta el perfil propio (ADOPTANTE)",
        "tags" : [ "Perfiles" ]
      },
      "put" : {
        "operationId" : "guardar",
