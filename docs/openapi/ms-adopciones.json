            "description" : "Faltan datos o son invalidos"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "No autenticado"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Rol insuficiente (requiere ADOPTANTE)"
          }
        },
        "summary" : "Crea o reemplaza el perfil propio (ADOPTANTE)",
        "tags" : [ "Perfiles" ]
      }
    },
