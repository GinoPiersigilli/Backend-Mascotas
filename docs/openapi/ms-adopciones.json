          },
          "tienePatio" : {
            "type" : "boolean"
          },
          "tipoVivienda" : {
            "enum" : [ "CASA", "DEPARTAMENTO" ],
            "example" : "CASA",
            "type" : "string"
          }
        },
        "required" : [ "direccion", "hayNinios", "hayOtrosAnimales", "localidad", "nombreCompleto", "provincia", "telefono", "tienePatio", "tipoVivienda" ],
