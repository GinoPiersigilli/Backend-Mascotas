    "/api/solicitudes" : {
      "get" : {
        "operationId" : "listar",
        "parameters" : [ {
          "description" : "Filtrar por estado",
          "example" : "PENDIENTE",
          "in" : "query",
          "name" : "estado",
          "required" : false,
          "schema" : {
            "enum" : [ "PENDIENTE", "APROBADA", "RECHAZADA", "CANCELADA", "EN_ADAPTACION", "FINALIZADA", "REVERTIDA" ],
            "type" : "string"
          }
        }, {
          "description" : "Filtrar solicitudes EN_ADAPTACION con control final vencido (solo COORDINADOR)",
          "example" : true,
          "in" : "query",
          "name" : "controlVencido",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Numero de pagina (base 0)",
          "example" : 0,
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "Cantidad de elementos por pagina (1 a 100)",
          "example" : 50,
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 50,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SolicitudResponse"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "Lista de solicitudes; el encabezado X-Total-Count informa el total",
            "headers" : {
              "X-Total-Count" : {
                "description" : "Cantidad total de registros",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Parametros de filtro o paginacion invalidos"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "No autenticado"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "Rol insuficiente"
          }
        },
        "summary" : "Lista solicitudes paginadas: las propias (ADOPTANTE) o todas (COORDINADOR)",
        "tags" : [ "Solicitudes" ]
      },
